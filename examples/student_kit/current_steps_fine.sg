sg 2 protocol
# Current clamp: finer steps around the threshold of the Hodgkin-Huxley soma (compare current_steps.sg).
sweep    amp = from 50pA to 100pA step 10pA
repeat   1
order    sequential
period   2s

stimulus {
    channel P1 unit=pA {
        200ms dc(0)
        @step
        800ms dc($amp)
        300ms dc(0)
    }
}
